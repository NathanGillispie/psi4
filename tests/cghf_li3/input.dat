# CGHF test that you get the correct converged energy for Li3 trimer.
#
# Unfortunately, we do not have stability yet, but we can still supply orbitals
# that have been converged with stability analysis in other software.

reference_e = -21.256848

molecule lithium_trimer {
0 4
  Li 0 0 0
  Li 1 0 0
  Li .5 0 .866
symmetry C1
}

set = {
    basis                   sto-3g
    reference               cghf
    guess                   read
    scf_type                direct
    df_scf_guess            false
    orbital_optimizer_package internal
}

e, wfn = energy('scf', return_wfn=True, restart_file='li3_ref_mos')

# ss, mult = wfn.spin_square()

compare_values(e, reference_e, 6, "Total energy")   #TEST
# compare_values(ss, 2.392, 2, "Spin-squared")        #TEST
# compare_values(mult, 3.2507, 2, "Multiplicity")     #TEST
